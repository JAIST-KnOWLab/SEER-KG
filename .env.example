# seer-kg credentials / tokens — copy to `.env` and fill in your own values.
# `.env` is git-ignored; never commit real tokens.

# Hugging Face access token. Needed ONLY to download gated model weights
# (runtime loading uses local_files_only and needs no token).
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Contact string embedded in the Wikidata User-Agent header (endpoint etiquette).
# An email or project URL is recommended by Wikidata.
WIKIDATA_CONTACT=you@example.com
